        "spacing": {
          "padding": {
            "left": "0",
            "right": "0"
          }
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "32px"
        }
      },
      "core/paragraph": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        },
        "typography": {
          "lineHeight": "1.625"
        }
      },
      "core/list": {
        "spacing": {
          "padding": {
            "left": "24px"
          },
          "margin": {
            "top": "0",
            "bottom": "24px"
          }
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      },
      "core/separator": {
        "border": {
          "width": "0 0 1px 0",
          "color": "currentColor",
          "style": "solid"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "24px"
        }
      }
    }
