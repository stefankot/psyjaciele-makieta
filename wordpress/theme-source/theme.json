  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|green"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|satoshi",
      "fontSize": "16px",
      "fontWeight": "500",
      "lineHeight": "1.625"
    },
    "spacing": {
      "blockGap": "24px",
      "padding": {
        "left": "clamp(24px,4.2vw,55px)",
        "right": "clamp(24px,4.2vw,55px)",
        "top": "0",
        "bottom": "0"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|satoshi",
          "fontWeight": "500",
          "lineHeight": "1.15",
          "letterSpacing": "-0.025em"
        },
        "color": {
          "text": "inherit"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|green",
          "text": "var:preset|color|peach-light"
        },
        "border": {
          "radius": "0",
          "width": "1px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|satoshi",
          "fontSize": "16px",
          "fontWeight": "900"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "24px",
            "right": "24px"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(40px,7vw,89px)",
          "lineHeight": "1.15"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(34px,5vw,55px)",
          "lineHeight": "1.15"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "34px",
          "lineHeight": "1.15"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "21px",
          "lineHeight": "1.15"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        }
      },
      "h5": {
        "typography": {
          "fontSize": "16px",
          "lineHeight": "1.15"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "14px",
          "lineHeight": "1.15"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "16px"
          }
        }
      }
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "blockGap": "24px"
        }
